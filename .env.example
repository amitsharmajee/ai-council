# AI Council Environment Configuration Template

# AI Execution Mode: MOCK (simulated for demo/testing) or LIVE (real paid API calls)
AI_MODE=LIVE

# AI Provider API Keys (Required when AI_MODE=LIVE)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Connection String Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ai_council?retryWrites=true&w=majority
